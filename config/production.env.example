# ==============================================================================
# Production Environment: vLLM High-Throughput Distributed Inference Server
# ==============================================================================

# Server Network Configuration
VLLM_PORT=8000
HOST=0.0.0.0

# Target Model Spec
MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_TOKEN=hf_your_production_huggingface_access_token_here

# Distributed Parallelism & Memory Hierarchy
TENSOR_PARALLEL_SIZE=1
PIPELINE_PARALLEL_SIZE=1
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=256
SWAP_SPACE=4

# Ray Distributed Cluster Ports
RAY_GCS_PORT=6379
RAY_DASHBOARD_PORT=8265
